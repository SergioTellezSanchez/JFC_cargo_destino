rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helper functions ───────────────────────────────────────────────────
    function isAuthenticated() {
      return request.auth != null;
    }

    function getRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isAdmin() {
      return isAuthenticated() && getRole() == 'ADMIN';
    }

    function isCarrier() {
      return isAuthenticated() && (getRole() == 'CARRIER' || getRole() == 'ADMIN');
    }

    function isDriver() {
      return isAuthenticated() && (getRole() == 'DRIVER' || getRole() == 'CARRIER' || getRole() == 'ADMIN');
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    // ─── Users ──────────────────────────────────────────────────────────────
    match /users/{userId} {
      // Users can read/write their own document; ADMIN can read all
      allow read: if isOwner(userId) || isAdmin() || isCarrier();
      // Allow creating own user doc on first login (role will default to CLIENT)
      allow create: if isOwner(userId);
      // Only ADMIN can update roles; owner can update own non-role fields
      allow update: if isAdmin() ||
        (isOwner(userId) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']));
    }

    // ─── Orders ─────────────────────────────────────────────────────────────
    match /orders/{orderId} {
      // ADMIN can do everything
      allow read, write: if isAdmin();

      // Authenticated users can read marketplace orders
      allow read: if isAuthenticated();

      // Client can create orders (their own quote flow creates them via API, but in case of direct SDK use)
      allow create: if isAuthenticated();

      // CARRIER can update only specific fields (request interest in a load)
      allow update: if isCarrier() &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['interestedCarriers', 'updatedAt']);

      // DRIVER can update specific delivery status fields
      allow update: if isDriver() &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'actualPickupTime', 'actualDeliveryTime', 'updatedAt']);
    }

    // ─── Settings (admin config) ─────────────────────────────────────────────
    match /settings/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // ─── Vehicles ───────────────────────────────────────────────────────────
    match /vehicles/{vehicleId} {
      allow read: if isAuthenticated();
      allow write: if isCarrier();
    }

    // ─── Warehouses / Storage ────────────────────────────────────────────────
    match /warehouses/{warehouseId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // ─── Auctions ────────────────────────────────────────────────────────────
    match /auctions/{auctionId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() || isCarrier();
    }

    // ─── Pricing / Tariffs ───────────────────────────────────────────────────
    match /pricing/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // ─── Analytics (write-only for clients, read for admin) ──────────────────
    match /analytics/{docId} {
      allow read: if isAdmin();
      allow write: if isAuthenticated();
    }

    // ─── Fallback: deny everything else ─────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
